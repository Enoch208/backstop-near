{
  "name": "backstop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "episode": "tsx scripts/episode.ts",
    "demo": "tsx scripts/demo.ts",
    "api": "tsx apps/api/src/main.ts",
    "test:chain": "vitest run -c vitest.chain.config.ts",
    "chain": "tsx scripts/chain.ts",
    "arena": "tsx scripts/arena.ts",
    "mcp": "tsx apps/mcp/src/main.ts",
    "market": "tsx scripts/market.ts",
    "chain:account": "tsx scripts/testnet-account.ts",
    "vault:build": "sh scripts/build-vault.sh",
    "verify:testnet": "tsx scripts/verify-testnet.ts",
    "vault:upgrade": "tsx scripts/upgrade-vault.ts",
    "tee": "tsx scripts/tee.ts",
    "chain:harden": "tsx scripts/harden.ts",
    "web": "pnpm --filter @backstop/web dev",
    "judge": "tsx scripts/judge.ts",
    "chain:redteam": "tsx scripts/red-team.ts",
    "worker:outside": "tsx services/workers/src/main.ts",
    "benchmark:live": "tsx scripts/live-benchmark.ts"
  },
  "devDependencies": {
    "@backstop/agents": "workspace:*",
    "@backstop/api": "workspace:*",
    "@backstop/fixture-checkout": "workspace:*",
    "@backstop/ledger": "workspace:*",
    "@backstop/mcp": "workspace:*",
    "@backstop/near": "workspace:*",
    "@backstop/orchestrator": "workspace:*",
    "@backstop/shared": "workspace:*",
    "@backstop/verifier": "workspace:*",
    "@backstop/workers": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "near-api-js": "7.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@backstop/tee": "workspace:*"
  }
}
